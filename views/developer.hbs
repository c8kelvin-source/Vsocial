{{#if loggedIn}}
  {{> yHeader}}
{{ else }}
  {{> nHeader}}
{{/if}}

<div class="dev_container">
  <div class="dev_header">
    <h1>Vsocial Developers</h1>
    <p class="dev_lead">Meet the team behind the platform.</p>
  </div>

  <div class="dev_profiles">
    <div class="profile_card">
      <div class="profile_avatar_wrapper">
        <div class="profile_avatar_fallback"><i class="fas fa-code"></i></div>
      </div>
      <h3 class="profile_name">Lead Architect</h3>
      <span class="profile_role">Full Stack Engineer</span>
      <p class="profile_bio">Responsible for system architecture, real-time socket integrations, and robust database design.</p>
      <div class="profile_links">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="profile_link"><i class="fab fa-github"></i> GitHub</a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="profile_link"><i class="fab fa-linkedin"></i> LinkedIn</a>
      </div>
    </div>

    <div class="profile_card">
      <div class="profile_avatar_wrapper">
        <div class="profile_avatar_fallback"><i class="fas fa-paint-brush"></i></div>
      </div>
      <h3 class="profile_name">Frontend Specialist</h3>
      <span class="profile_role">UI/UX Engineer</span>
      <p class="profile_bio">Crafts the premium aesthetic design system, interactive layouts, animations, and responsive components.</p>
      <div class="profile_links">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="profile_link"><i class="fab fa-github"></i> GitHub</a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="profile_link"><i class="fab fa-linkedin"></i> LinkedIn</a>
      </div>
    </div>
  </div>
</div>

{{> footer}}
