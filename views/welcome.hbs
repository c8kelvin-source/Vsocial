{{> nHeader }}

<div class="notes_wrapper welcome_wrapper">
  <!-- Hero Section -->
  <header class="welcome_hero">
    <div class="hero_content">
      <h1 class="hero_title">Welcome to <span class="brand_gradient">Vsocial</span></h1>
      <p class="hero_lead">A next-generation, reactive social network built for moments that matter. Capture, follow, like, and share your world with communities built around what you love.</p>
      <div class="hero_actions">
        <a href="/signup" class="btn_primary hero_btn">Get Started for Free</a>
        <a href="/about" class="btn_secondary hero_btn">Explore Features</a>
      </div>
    </div>
    <div class="hero_image_wrapper">
      <img src="/images/omg.png" alt="Vsocial App Showcase" class="hero_img">
    </div>
  </header>

  <!-- Feature Grid Section -->
  <section class="welcome_features">
    <h2 class="section_title">Why Choose Vsocial?</h2>
    <div class="features_grid">
      <div class="feature_card">
        <div class="card_icon"><i class="fas fa-camera-retro"></i></div>
        <h3>Interactive Posts</h3>
        <p>Share photos, tag friends, add captions, and customize who can see your moments.</p>
      </div>
      <div class="feature_card">
        <div class="card_icon"><i class="fas fa-comments"></i></div>
        <h3>Direct Messaging</h3>
        <p>Engage in real-time private conversations with rich media support and notifications.</p>
      </div>
      <div class="feature_card">
        <div class="card_icon"><i class="fas fa-users"></i></div>
        <h3>Communities & Groups</h3>
        <p>Create interest-based groups, share exclusive content, and invite members.</p>
      </div>
      <div class="feature_card">
        <div class="card_icon"><i class="fas fa-bell"></i></div>
        <h3>Instant Notifications</h3>
        <p>Stay up to date with real-time feedback on likes, comments, and mentions.</p>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="welcome_cta">
    <div class="cta_card">
      <h2>Ready to start your journey?</h2>
      <p>Join thousands of users sharing their stories every single day.</p>
      <a href="/signup" class="btn_primary cta_btn">Join Vsocial Today</a>
    </div>
  </section>
</div>

{{> footer }}
