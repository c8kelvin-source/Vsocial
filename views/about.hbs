{{#if loggedIn}}
  {{> yHeader}}
{{ else }}
  {{> nHeader}}
{{/if}}

<div class="about_container">
  <div class="about_header">
    <h1>About Vsocial</h1>
    <p class="about_lead">A reactive social network built to bring people closer through seamless sharing and modern technology.</p>
  </div>

  <div class="pillars_grid">
    <div class="pillar_card">
      <div class="pillar_icon"><i class="fab fa-react"></i></div>
      <h3>Reactive UI</h3>
      <p>Powered by React and virtual DOM techniques to deliver instantaneous page transitions, updates, and interactions without page reloads.</p>
    </div>

    <div class="pillar_card">
      <div class="pillar_icon"><i class="fas fa-server"></i></div>
      <h3>Robust Backend</h3>
      <p>Built with Express and Node.js to power a fast and secure API layer, coupled with structured MySQL database queries for persistent state.</p>
    </div>

    <div class="pillar_card">
      <div class="pillar_icon"><i class="fas fa-bolt"></i></div>
      <h3>Real-time Delivery</h3>
      <p>Utilizes WebSocket (Socket.io) technology to push messages, notifications, and updates straight to users in real time.</p>
    </div>
  </div>
</div>

{{> footer}}
